# Hourly release of expired, unpaid unit holds (FR-081; docs/DEPLOYMENT_PROXY.md §7b).
# Installed with the other timers by scripts/ops/install-timers.sh (or copy to /etc/systemd/system/).
# Adjust User, Group, WorkingDirectory and EnvironmentFile if the app lives elsewhere.
[Unit]
Description=MZ CRM: release expired unit holds
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=mzcrm
Group=mzcrm
WorkingDirectory=/srv/mz-crm
# Supplies DATABASE_URL (plain KEY=value lines, mode 600, owned by the app user).
EnvironmentFile=/srv/mz-crm/.env
ExecStart=/usr/bin/node scripts/jobs/release-holds.mjs
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
