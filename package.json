{
  "name": "mz-marketing-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/next/dist/bin/next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "npm run build && node node_modules/@playwright/test/cli.js test",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "job:prune-signin-logs": "node scripts/jobs/prune-signin-logs.mjs",
    "job:release-holds": "node scripts/jobs/release-holds.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.563.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
