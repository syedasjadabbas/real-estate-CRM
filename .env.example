# PostgreSQL Database Connection Strings
DATABASE_URL=postgres://user:password@localhost:5432/mz_crm
TEST_DATABASE_URL=postgres://user:password@localhost:5432/mz_crm_test


# Client IP behind a trusted reverse proxy (docs/DEPLOYMENT_PROXY.md).
# Without TRUST_PROXY=true, production records no client IP; browser-sent headers are never trusted.
TRUST_PROXY=false
TRUSTED_PROXY_COUNT=1
# CLIENT_IP_HEADER=x-forwarded-for
# PROXY_SHARED_SECRET=

# Private storage for uploaded call recordings (docs/DEPLOYMENT_PROXY.md §9). Default: ./storage
# FILE_STORAGE_DIR=/srv/mz-crm-data/storage

# Backups (scripts/ops/RESTORE.md). Server only; names listed here, set the values on the server.
# BACKUP_DIR=                 absolute folder for backups, outside the app folder and FILE_STORAGE_DIR
# BACKUP_REMOTE=              optional rsync destination for the off-server copy
# BACKUP_KEEP_DAILY=          newest backup of each of the last N days kept locally (default 30)
# BACKUP_KEEP_MONTHLY=        newest backup of each of the last N months kept locally (default 12; 0 = none)
#                             (BACKUP_RETENTION_DAYS / BACKUP_RETENTION_COUNT are no longer used and are refused)
# RESTORE_CHECK_DATABASE=     optional disposable database for restore-check.sh (it is overwritten)

# Browser (WebRTC) calling — docs/VOIP_INTEGRATION.md. Unset = calling not set up (the lead page
# offers the phone's tel: link). No provider adapter is implemented yet; names only, never commit values.
# VOIP_PROVIDER=
# Twilio: TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID, TWILIO_API_KEY_SECRET, TWILIO_TWIML_APP_SID, TWILIO_CALLER_ID
# Vonage: VONAGE_APPLICATION_ID, VONAGE_PRIVATE_KEY_PATH, VONAGE_CALLER_ID
# Plivo: PLIVO_AUTH_ID, PLIVO_AUTH_TOKEN, PLIVO_APP_ID, PLIVO_CALLER_ID
# Telnyx: TELNYX_API_KEY, TELNYX_CREDENTIAL_CONNECTION_ID, TELNYX_PUBLIC_KEY, TELNYX_CALLER_ID
# Self-hosted SIP: SIP_WSS_URI, SIP_DOMAIN, SIP_TURN_URI, SIP_TURN_SECRET
